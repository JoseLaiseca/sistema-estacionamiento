@model List<EstacionamientoWebApp.Models.Comprobante>

@{
    ViewData["Title"] = "Facturas Electrónicas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Factura
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay comprobantes registrados. <a asp-action="Crear">Crear uno nuevo</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Tipo</th>
                        <th>Total</th>
                        <th>CAE</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comprobante in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(comprobante.NumeroComprobante))
                                {
                                    <span>@comprobante.PuntoVenta.ToString("D4")-@comprobante.NumeroComprobante</span>
                                }
                                else
                                {
                                    <span class="text-muted">Pendiente</span>
                                }
                            </td>
                            <td>@comprobante.FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div>@(comprobante.RazonSocialCliente ?? "Sin cliente")</div>
                                <small class="text-muted">@comprobante.CuitCliente</small>
                            </td>
                            <td>
                                @switch (comprobante.TipoComprobante)
                                {
                                    case 1: <span class="badge bg-primary">Factura A</span> break;
                                    case 6: <span class="badge bg-success">Factura B</span> break;
                                    case 11: <span class="badge bg-info">Factura C</span> break;
                                    default: <span>@comprobante.TipoComprobante</span> break;
                                }
                            </td>
                            <td>$@comprobante.ImporteTotal.ToString("N2")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(comprobante.CAE))
                                {
                                    <span class="badge bg-success">@comprobante.CAE</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @switch (comprobante.Estado)
                                {
                                    case "Autorizado":
                                        <span class="badge bg-success">Autorizado</span>
                                        break;
                                    case "Rechazado":
                                        <span class="badge bg-danger">Rechazado</span>
                                        break;
                                    default:
                                        <span class="badge bg-warning">@comprobante.Estado</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-action="Ver" asp-route-id="@comprobante.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

