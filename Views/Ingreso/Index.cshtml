<script>
    (function(){
      const $input = document.getElementById('scanInput');
      const $btnCalcular = document.getElementById('btnCalcular');
      const $btnLimpiar = document.getElementById('btnLimpiar');
      const $resultado = document.getElementById('resultadoScan');
      const $detalle = document.getElementById('detalleCobro');

      const $outTipo = document.getElementById('outTipo');
      const $outPatente = document.getElementById('outPatente');
      const $outEntrada = document.getElementById('outEntrada');
      const $outAhora = document.getElementById('outAhora');
      const $outMin = document.getElementById('outMin');
      const $outMonto = document.getElementById('outMonto');

      function mostrarMensaje(ok, msg) {
        $resultado.classList.remove('d-none', 'alert-success', 'alert-danger');
        $resultado.classList.add(ok ? 'alert-success' : 'alert-danger');
        $resultado.textContent = msg;
      }

      function limpiar() {
        $input.value = '';
        $resultado.classList.add('d-none');
        $detalle.classList.add('d-none');
        $input.focus();
      }

      async function calcular() {
        const codigo = ($input.value || '').trim();
        if (!codigo) {
          mostrarMensaje(false, 'Ingresá o escaneá un código primero.');
          return;
        }
        try {
          const resp = await fetch('/Ingreso/CalcularCobroCodigo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codigo })
          });
          const data = await resp.json();

          if (!data.ok) {
            mostrarMensaje(false, data.mensaje || 'Error al calcular.');
            $detalle.classList.add('d-none');
            return;
          }

          mostrarMensaje(true, 'Cálculo ok. ¡Podés cobrar!');
          $outTipo.textContent = data.tipo;
          $outPatente.textContent = data.patente;
          $outEntrada.textContent = data.horaEntrada;
          $outAhora.textContent = data.horaActual;
          $outMin.textContent = data.minutos;
          $outMonto.textContent = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(data.monto);
          $detalle.classList.remove('d-none');

          // Limpia el input si tu lector manda Enter al final
          // $input.value = '';
        } catch (e) {
          mostrarMensaje(false, 'No se pudo conectar con el servidor.');
          $detalle.classList.add('d-none');
        }
      }

      // Escáner suele enviar Enter al final → disparar cálculo
      $input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') {
          ev.preventDefault();
          calcular();
        }
      });
      $btnCalcular.addEventListener('click', calcular);
      $btnLimpiar.addEventListener('click', limpiar);
    })();
</script>

