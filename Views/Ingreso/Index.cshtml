                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Vehículo</th>
                                <th>Patente</th>
                                <th>Cliente</th>
                                <th>Precio</th>
                                <th>Descripción</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                <tbody id="tbodyMensuales">
                    <!-- Los datos se cargarán dinámicamente -->
                </tbody>
            </table>
        </div>

        <!-- Modal para editar mensual -->
        <div class="modal fade" id="modalEditarMensual" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar Mensual</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="formEditarMensual">
                        <div class="modal-body">
                            <input type="hidden" id="editId" name="Id">
                            
                            <div class="mb-3">
                                <label for="editVehiculo" class="form-label">Tipo de Vehículo</label>
                                <select id="editVehiculo" name="Vehiculo" class="form-select" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Auto">Auto</option>
                                    <option value="Camioneta">Camioneta</option>
                                    <option value="Moto">Moto</option>
                                    <option value="Combi">Combi</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="editPatente" class="form-label">Patente</label>
                                <input type="text" id="editPatente" name="Patente" class="form-control" maxlength="8" required>
                            </div>

                            <div class="mb-3">
                                <label for="editNombre" class="form-label">Nombre del Cliente</label>
                                <input type="text" id="editNombre" name="Nombre" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="editPrecio" class="form-label">Precio ($)</label>
                                <input type="number" id="editPrecio" name="Precio" class="form-control" step="0.01" required>
                            </div>

                            <div class="mb-3">
                                <label for="editDescripcion" class="form-label">Descripción</label>
                                <input type="text" id="editDescripcion" name="Descripcion" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="editFechaVencimiento" class="form-label">Fecha de Vencimiento</label>
                                <input type="date" id="editFechaVencimiento" name="FechaVencimiento" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input type="checkbox" id="editActivo" name="Activo" class="form-check-input">
                                    <label for="editActivo" class="form-check-label">Activo</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Leer pestaña activa desde localStorage
        var activeTab = localStorage.getItem("activeTab");
        if (activeTab) {
            var tab = document.querySelector(`#myTab button[data-bs-target="${activeTab}"]`);
            if (tab) {
                new bootstrap.Tab(tab).show();
            }
        }

        // Guardar la pestaña activa cuando se cambia
        document.querySelectorAll('#myTab button[data-bs-toggle="tab"]').forEach(function (tab) {
            tab.addEventListener("shown.bs.tab", function (e) {
                localStorage.setItem("activeTab", e.target.getAttribute("data-bs-target"));
            });
        });
    });
</script>
<script>
    function eliminarRegistro(id) {
        if (!confirm("¿Seguro que quieres eliminar este registro?")) return;

        fetch(`/Ingreso/Eliminar/${id}`, {
            method: 'DELETE'
        })
        .then(r => {
            if (r.ok) {
                alert("Registro eliminado");
                location.reload();
            } else {
                alert("Error al eliminar");
            }
        });
    }

    function imprimirRegistro(id) {
    fetch(`/Ingreso/ImprimirGuardado/${id}`)
        .then(r => {
            if (r.ok) {
                alert("Ticket enviado a imprimir");
            } else {
                alert("Error al imprimir");
            }
        })
        .catch(err => alert("Error: " + err));
}


    // ===== FUNCIONALIDAD PARA MENSUALES REGISTRADOS =====
    
