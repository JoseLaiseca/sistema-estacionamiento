@model EstacionamientoWebApp.Models.IngresoViewModel

@using EstacionamientoWebApp.Models

@{
    ViewData["Title"] = "Ingreso";
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="form-tab" data-bs-toggle="tab" data-bs-target="#formulario" type="button" role="tab">Nuevo Ingreso</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tabla-tab" data-bs-toggle="tab" data-bs-target="#tabla" type="button" role="tab">Ingresos Registrados</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="estadia-tab" data-bs-toggle="tab" data-bs-target="#estadia" type="button" role="tab">Estadía Prolongada</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="mensual-tab" data-bs-toggle="tab" data-bs-target="#mensual" type="button" role="tab">Nuevo Mensual</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="mensuales-registrados-tab" data-bs-toggle="tab" data-bs-target="#mensuales-registrados" type="button" role="tab">Mensuales Registrados</button>
    </li>

   
</ul>

<div class="tab-content mt-4" id="myTabContent">
    <!-- Pestaña 1: Formulario de ingreso simple -->
    <div class="tab-pane fade show active" id="formulario" role="tabpanel">
        <h3>Ingreso de vehículo</h3>
        <p class="text-muted">
            <strong>Fecha y hora actual:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
        </p>


        <form asp-controller="Ingreso" asp-action="Guardar" method="post">
            <div class="mb-3">
                <div class="col-md-6">
                    <label>Tipo de Vehículo</label>
                    <select name="TipoVehiculo" class="form-select" required>
                        <option value="">-- Seleccionar --</option>
                        <option>Moto</option>
                        <option>Auto</option>
                        <option>Camioneta</option>
                        <option>Utilitario</option>
                        <option>Combi</option>
                    </select>
                </div>
                <div class="col-mb-6">
                    <label>Patente</label>
                    <input type="text" name="Patente" class="form-control" maxlength="8" />
                </div>
                <div class="col-mb-6">
                    <label>Descripción</label>
                    <input type="text" name="Descripcion" class="form-control" />
                </div>
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="submit" formaction="/Ingreso/ImprimirRecienIngresado" class="btn btn-success">Imprimir</button>
                    <a asp-action="Cancelar" class="btn btn-secondary">Cancelar</a>
                </div>
                <a class="btn btn-success btn-lg w-100 d-inline-flex align-items-center justify-content-center gap-2"
                   href="@Url.Action("Cobrar","Ingreso")">
                    <i class="bi bi-upc-scan"></i> Ir a Cobrar
                </a>



            </div>
        </form>

       
    </div>

    <!-- Pestaña 2: Tabla de ingresos -->
    <div class="tab-pane fade" id="tabla" role="tabpanel">
        <h3>Ingresos recientes</h3>
        <!-- 🟡 Formulario de filtro por fecha -->
        <form method="get" asp-controller="Ingreso" asp-action="Index" class="row g-3 mb-4">
            <div class="col-auto">
                <label for="fecha" class="form-label">Filtrar por fecha:</label>
                <input type="date" name="fecha" id="fecha" class="form-control"
                       value="@Model.FechaFiltro?.ToString("yyyy-MM-dd")" />
                


                @* value="@Request.Query["fecha"]" /> *@
            </div>
            <a class="btn btn-warning btn-lg w-100 d-inline-flex align-items-center justify-content-center gap-2"
               href="@Url.Action("Cobrar","Ingreso")">
                <i class="bi bi-upc-scan"></i> Ir a Cobrar
            </a>

            <div class="col-auto d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
            <div class="col-auto d-flex align-items-end">
                <!-- Este botón resetea el filtro -->
                <a href="@Url.Action("Index", "Ingreso")" class="btn btn-secondary">Quitar Filtro</a>
            </div>
        </form>
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label for="fecha" class="form-label mb-0">Ver ingresos del día</label>
                <input type="date"
                       id="fecha"
                       name="fecha"
                       class="form-control"
                       value="@(Model.FechaFiltro?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>

            <div class="col-auto">
                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Index","Ingreso", new { fecha = DateTime.Today.ToString("yyyy-MM-dd") })">
                    Hoy
                </a>
            </div>

            <div class="col-auto">
                <button type="button" id="btnAyer" class="btn btn-outline-secondary">Ayer</button>
            </div>
        </form>

        <script>
            document.getElementById('btnAyer')?.addEventListener('click', () => {
              const d = new Date();
              d.setDate(d.getDate() - 1);
              const yyyy = d.getFullYear();
              const mm = String(d.getMonth()+1).padStart(2,'0');
              const dd = String(d.getDate()).padStart(2,'0');
              const input = document.getElementById('fecha');
              input.value = `${yyyy}-${mm}-${dd}`;
              input.form.submit();
            });

            // enter en el date = submit
            document.getElementById('fecha')?.addEventListener('keydown', (ev)=>{
              if (ev.key === 'Enter') { ev.preventDefault(); ev.target.form.submit(); }
            });
        </script>

        @if (Model.Ingresos != null && Model.Ingresos.Count > 0)

        {
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Patente</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingreso in Model.Ingresos)
                    {
                        <tr>
                            <td>@ingreso.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@ingreso.TipoVehiculo</td>
                            <td>@(ingreso.Patente ?? "-")</td>
                            <td>@(ingreso.Descripcion ?? "-")</td>                        
                            <td>
                                <button class="btn btn-danger btn-sm" onclick="eliminarRegistro(@ingreso.Id)">Eliminar</button>
                                <button class="btn btn-primary btn-sm" onclick="imprimirRegistro(@ingreso.Id)">Imprimir</button>
                                <a asp-controller="Facturacion"
                                   asp-action="Crear"
                                   asp-route-ingresoId="@ingreso.Id"
                                   class="btn btn-sm btn-success">
                                    <i class="bi bi-receipt"></i> Generar Factura AFIP
                                </a>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No hay ingresos registrados.</div>
        }
    </div>

    <!-- Pestaña 3: Formulario estadía prolongada -->
    <div class="tab-pane fade" id="estadia" role="tabpanel">
        <h3>Estadía prolongada</h3>
        
        <!-- Formulario de nueva estadía -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Nueva Estadía</h5>
            </div>
            <div class="card-body">
        <form method="post" asp-action="GuardarEstadia">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Estadia.NombreCliente" class="form-label">Nombre del Cliente</label>
                    <input asp-for="Estadia.NombreCliente" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Estadia.Celular" class="form-label">Celular</label>
                    <input asp-for="Estadia.Celular" class="form-control" required />
                </div>
            </div>
            <div class="row mb-3">
                        <div class="col-md-4">
                    <label asp-for="Estadia.Patente" class="form-label">Patente</label>
                    <input asp-for="Estadia.Patente" class="form-control" required />
                </div>
                        <div class="col-md-4">
                            <label asp-for="Estadia.TipoVehiculo" class="form-label">Tipo de Vehículo</label>
                            <select asp-for="Estadia.TipoVehiculo" class="form-select" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="Auto">Auto</option>
                                <option value="Moto">Moto</option>
                                <option value="Camioneta">Camioneta</option>
                                <option value="Combi">Combi</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                    <label asp-for="Estadia.Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Estadia.Descripcion" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                            <label asp-for="Estadia.DejoLlave" class="form-label">¿Llave?</label>
                    <select asp-for="Estadia.DejoLlave" class="form-select" required>
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Estadia.DiasEstadia" class="form-label">Días de estadía</label>
                    <input asp-for="Estadia.DiasEstadia" type="number" class="form-control" required min="1" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Estadia.Monto" class="form-label">Monto ($)</label>
                    <input asp-for="Estadia.Monto" type="number" class="form-control" step="0.01" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar estadía</button>
        </form>
            </div>
        </div>

        <!-- Tabla de estadías registradas -->
