            const mensual = await response.json();
            
            // Llenar el modal con los datos
            document.getElementById('editId').value = mensual.id;
            document.getElementById('editVehiculo').value = mensual.vehiculo;
            document.getElementById('editPatente').value = mensual.patente;
            document.getElementById('editNombre').value = mensual.nombre;
            document.getElementById('editPrecio').value = mensual.precio;
            document.getElementById('editDescripcion').value = mensual.descripcion || '';
            document.getElementById('editFechaVencimiento').value = mensual.fechaVencimiento.split('T')[0];
            document.getElementById('editActivo').checked = mensual.activo;
            
            // Mostrar el modal
            new bootstrap.Modal(document.getElementById('modalEditarMensual')).show();
