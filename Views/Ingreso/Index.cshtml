            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar Estadía</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="formEditarEstadia">
                        <div class="modal-body">
                            <input type="hidden" id="editEstadiaId" name="Id">
                            
                            <div class="mb-3">
                                <label for="editEstadiaNombre" class="form-label">Nombre del Cliente</label>
                                <input type="text" id="editEstadiaNombre" name="NombreCliente" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="editEstadiaCelular" class="form-label">Celular</label>
                                <input type="text" id="editEstadiaCelular" name="Celular" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="editEstadiaPatente" class="form-label">Patente</label>
                                <input type="text" id="editEstadiaPatente" name="Patente" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="editEstadiaTipoVehiculo" class="form-label">Tipo de Vehículo</label>
                                <select id="editEstadiaTipoVehiculo" name="TipoVehiculo" class="form-select" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Auto">Auto</option>
                                    <option value="Moto">Moto</option>
                                    <option value="Camioneta">Camioneta</option>
                                    <option value="Combi">Combi</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="editEstadiaDescripcion" class="form-label">Descripción</label>
                                <input type="text" id="editEstadiaDescripcion" name="Descripcion" class="form-control">
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="editEstadiaDejoLlave" class="form-label">¿Llave?</label>
                                    <select id="editEstadiaDejoLlave" name="DejoLlave" class="form-select" required>
                                        <option value="true">Sí</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="editEstadiaDias" class="form-label">Días de estadía</label>
                                    <input type="number" id="editEstadiaDias" name="DiasEstadia" class="form-control" required min="1">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="editEstadiaMonto" class="form-label">Monto ($)</label>
                                <input type="number" id="editEstadiaMonto" name="Monto" class="form-control" step="0.01" required>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestaña 4: Formulario mensuales -->
    <div class="tab-pane fade" id="mensual" role="tabpanel">
        <h3>Mensuales</h3>
        <!-- 👇 CAMBIO: especifico controller + token + resumen de validación -->
        <form method="post" asp-controller="Ingreso" asp-action="GuardarMensual">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Mensual.Vehiculo" class="form-label">Tipo de Vehículo</label>
                    <select asp-for="Mensual.Vehiculo" class="form-select" required>
                        <option value="">-- Seleccionar --</option>
                        <option>Auto</option>
                        <option>Camioneta</option>
                        <option>Moto</option>
                        <option>Combi</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Mensual.Patente" class="form-label">Patente</label>
                    <input asp-for="Mensual.Patente" class="form-control" maxlength="8" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Mensual.Nombre" class="form-label">Nombre del Cliente</label>
                    <input asp-for="Mensual.Nombre" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Mensual.Precio" class="form-label">Precio ($)</label>
                    <input asp-for="Mensual.Precio" type="number" class="form-control" step="0.01" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <label asp-for="Mensual.Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Mensual.Descripcion" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar mensual</button>
        </form>
    </div>

    <!-- Pestaña 5: Lista de mensuales registrados -->
    <div class="tab-pane fade" id="mensuales-registrados" role="tabpanel">
        <h3>Mensuales Registrados</h3>
        
        <!-- Filtros -->
        <div class="row mb-3">
            <div class="col-md-3">
                <label for="filtroEstado" class="form-label">Estado:</label>
                <select id="filtroEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="activo">Activos</option>
                    <option value="inactivo">Inactivos</option>
                    <option value="vencido">Vencidos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroPatente" class="form-label">Patente:</label>
                <input type="text" id="filtroPatente" class="form-control" placeholder="Buscar por patente...">
            </div>
            <div class="col-md-3">
                <label for="filtroCliente" class="form-label">Cliente:</label>
                <input type="text" id="filtroCliente" class="form-control" placeholder="Buscar por nombre...">
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="button" id="btnFiltrar" class="btn btn-primary me-2">Filtrar</button>
                <button type="button" id="btnLimpiarFiltros" class="btn btn-outline-secondary">Limpiar</button>
            </div>
        </div>

        <!-- Tabla de mensuales -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="tablaMensuales">
