                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Celular</th>
                                <th>Patente</th>
                                <th>Tipo</th>
                                <th>Días</th>
                                <th>Monto</th>
                                <th>Llave</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyEstadias">
