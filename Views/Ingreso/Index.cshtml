    // Cargar mensuales desde el servidor
    async function cargarMensuales() {
        try {
            const response = await fetch('/Ingreso/ObtenerMensuales');
            const mensuales = await response.json();
            mostrarMensuales(mensuales);
        } catch (error) {
            console.error('Error al cargar mensuales:', error);
            alert('Error al cargar los mensuales');
        }
    }

    // Mostrar mensuales en la tabla
    function mostrarMensuales(mensuales) {
        const tbody = document.getElementById('tbodyMensuales');
        tbody.innerHTML = '';

        if (mensuales.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="text-center">No hay mensuales registrados</td></tr>';
            return;
        }

        mensuales.forEach(mensual => {
            const row = document.createElement('tr');
            
            // Determinar estado y clase CSS
            let estado = 'Activo';
            let estadoClass = 'text-success';
            if (!mensual.activo) {
                estado = 'Inactivo';
                estadoClass = 'text-secondary';
            } else if (new Date(mensual.fechaVencimiento) < new Date()) {
                estado = 'Vencido';
                estadoClass = 'text-warning';
            }

            row.innerHTML = `
                <td>${mensual.id}</td>
                <td>${new Date(mensual.fecha).toLocaleDateString('es-AR')}</td>
                <td>${mensual.vehiculo}</td>
                <td>${mensual.patente}</td>
                <td>${mensual.nombre}</td>
                <td>$${mensual.precio.toLocaleString('es-AR')}</td>
                <td>${mensual.descripcion || '-'}</td>
                <td>${new Date(mensual.fechaVencimiento).toLocaleDateString('es-AR')}</td>
                <td><span class="${estadoClass}">${estado}</span></td>
                <td>
                    <button class="btn btn-sm btn-primary me-1" onclick="editarMensual(${mensual.id})">
                        <i class="bi bi-pencil"></i> Editar
                    </button>
                    <button class="btn btn-sm btn-danger me-1" onclick="eliminarMensualDesdeTabla(${mensual.id})">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                    <button class="btn btn-sm btn-success" onclick="imprimirMensual(${mensual.id})">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    // Editar mensual
    async function editarMensual(id) {
        try {
