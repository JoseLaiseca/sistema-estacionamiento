@model EstacionamientoWebApp.Models.Comprobante

@{
    ViewData["Title"] = "Detalle del Comprobante";
}

<h2 class="mt-3">Detalle del Comprobante</h2>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Información del Comprobante</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Número:</dt>
                    <dd class="col-sm-8">@Model.NumeroComprobante</dd>

                    <dt class="col-sm-4">Punto de Venta:</dt>
                    <dd class="col-sm-8">@Model.PuntoVenta</dd>

                    <dt class="col-sm-4">Tipo:</dt>
                    <dd class="col-sm-8">
                        @(Model.TipoComprobante switch
                        {
                            1 => "Factura A",
                            6 => "Factura B",
                            11 => "Factura C",
                            _ => $"Tipo {Model.TipoComprobante}"
                        })
                    </dd>

                    <dt class="col-sm-4">Fecha Emisión:</dt>
                    <dd class="col-sm-8">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Estado:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Estado == "Autorizado")
                        {
                            <span class="badge bg-success">@Model.Estado</span>
                        }
                        else if (Model.Estado == "Rechazado")
                        {
                            <span class="badge bg-danger">@Model.Estado</span>
                        }
                        else if (Model.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">@Model.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Estado</span>
                        }
                    </dd>

                    @if (!string.IsNullOrEmpty(Model.CAE))
                    {
                        <dt class="col-sm-4">CAE:</dt>
                        <dd class="col-sm-8"><strong>@Model.CAE</strong></dd>

                        <dt class="col-sm-4">Fecha Vto. CAE:</dt>
                        <dd class="col-sm-8">@(Model.FechaVtoCAE?.ToString("dd/MM/yyyy") ?? "N/A")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>Información del Cliente</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Razón Social:</dt>
                    <dd class="col-sm-8">@(Model.RazonSocialCliente ?? "Consumidor Final")</dd>

                    <dt class="col-sm-4">CUIT:</dt>
                    <dd class="col-sm-8">@(Model.CuitCliente ?? "N/A")</dd>

                    <dt class="col-sm-4">Domicilio:</dt>
                    <dd class="col-sm-8">@(Model.DomicilioCliente ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5>Detalles del Comprobante</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Alícuota IVA</th>
                            <th>Subtotal</th>
                            <th>Neto</th>
                            <th>IVA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in Model.Detalles)
                        {
                            <tr>
                                <td>@detalle.Descripcion</td>
                                <td>@detalle.Cantidad.ToString("N2")</td>
                                <td>@detalle.PrecioUnitario.ToString("C")</td>
                                <td>@detalle.AlicuotaIVA.ToString("N2")%</td>
                                <td>@detalle.Subtotal.ToString("C")</td>
                                <td>@detalle.ImporteNeto.ToString("C")</td>
                                <td>@detalle.ImporteIVA.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="4" class="text-end">Totales:</th>
                            <th>@Model.ImporteTotal.ToString("C")</th>
                            <th>@Model.ImporteNeto.ToString("C")</th>
                            <th>@Model.ImporteIVA.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Observaciones))
{
    <div class="alert alert-info mt-3">
        <strong>Observaciones:</strong> @Model.Observaciones
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>

