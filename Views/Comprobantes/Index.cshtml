@model IEnumerable<EstacionamientoWebApp.Models.Comprobante>

@{
    ViewData["Title"] = "Comprobantes";
}

<h2 class="mt-3">Listado de Comprobantes</h2>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>N°</th>
            <th>Fecha Emisión</th>
            <th>Cliente</th>
            <th>CUIT</th>
            <th>Importe Total</th>
            <th>CAE</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.NumeroComprobante</td>
            <td>@c.FechaEmision.ToString("dd/MM/yyyy")</td>
            <td>@c.RazonSocialCliente</td>
            <td>@c.CuitCliente</td>
            <td>@c.ImporteTotal.ToString("C")</td>
            <td>@c.CAE</td>
            <td>
                @if (c.Estado == "Autorizado")
                {
                    <span class="badge bg-success">@c.Estado</span>
                }
                else if (c.Estado == "Rechazado")
                {
                    <span class="badge bg-danger">@c.Estado</span>
                }
                else if (c.Estado == "Pendiente")
                {
                    <span class="badge bg-warning text-dark">@c.Estado</span>
                }
                else
                {
                    <span class="badge bg-secondary">@c.Estado</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Ver</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        No hay comprobantes registrados.
    </div>
}

